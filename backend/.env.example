# Banco de dados
DATABASE_URL="file:./dev.db"

# JWT
JWT_SECRET="sua-chave-secreta-aqui"

# Frontend URL (produção)
FRONTEND_URL="http://localhost:5173"

# ── Ouvidoria - Configurações de E-mail ──────────────────────────────
# E-mail que vai RECEBER as denúncias da ouvidoria
OUVIDORIA_EMAIL="ouvidoria.lifting@gmail.com"

# Configurações SMTP (servidor de envio de e-mail)
SMTP_HOST="smtp.gmail.com"         # Ex: smtp.gmail.com | smtp.office365.com
SMTP_PORT="587"                    # 587 = TLS (recomendado) | 465 = SSL
SMTP_SECURE="false"                # false para TLS (porta 587), true para SSL (porta 465)
SMTP_USER="seuemail@gmail.com"     # Usuário/e-mail do remetente
SMTP_PASS="sua-senha-de-app"       # Senha ou App Password do Gmail
