generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Sector {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  color     String     @default("#00A859")
  active    Boolean    @default(true)
  employees Employee[]
  tickets   Ticket[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @default(now()) @updatedAt
}

model Employee {
  id           Int      @id @default(autoincrement())
  name         String
  username     String?  @unique
  passwordHash String?
  active       Boolean  @default(true)
  sectorId     Int
  sector       Sector   @relation(fields: [sectorId], references: [id], onDelete: Restrict)
  tickets      Ticket[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
}

model Ticket {
  id                Int      @id @default(autoincrement())
  employeeId        Int
  sectorId          Int
  category          String
  origin            String
  description       String
  department        String   @default("TI")
  status            String   @default("Aberto")
  priority          String   @default("Normal")
  technicalResponse String?
  archived          Boolean  @default(false)
  autoCloseWarnedAt DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  employee    Employee           @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  sector      Sector             @relation(fields: [sectorId], references: [id], onDelete: Restrict)
  timeline    Timeline[]
  messages    TicketMessage[]
  attachments TicketAttachment[]
}

model TicketMessage {
  id         Int      @id @default(autoincrement())
  ticketId   Int
  senderType String
  senderName String
  message    String
  createdAt  DateTime @default(now())

  ticket      Ticket             @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  attachments TicketAttachment[]
}

model TicketAttachment {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  messageId Int?
  filename  String
  mimeType  String
  size      Int
  data      String
  createdAt DateTime @default(now())

  ticket  Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  message TicketMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([messageId])
}

model PushSubscription {
  id        Int      @id @default(autoincrement())
  sector    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

model Timeline {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  action    String
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

model DepartmentEmail {
  id         Int      @id @default(autoincrement())
  department String
  email      String
  createdAt  DateTime @default(now())

  @@unique([department, email])
  @@index([department])
}
